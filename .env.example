# ── Django ──────────────────────────────────────────────────────
# Genera con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=CHANGE-ME-50-RANDOM-CHARS

# 1 = modo desarrollo (NO usar en prod)
DJANGO_DEBUG=0

# CSV de hosts permitidos (Host header). Sin espacios.
DJANGO_ALLOWED_HOSTS=cogny.example.com,127.0.0.1,localhost

# Sube este valor (v1, v2, v3…) cada vez que cambies un estático global
# (app.css, JS compartido) para forzar cache-busting (?v=... en base.html).
ASSET_VERSION=v1

# ── Rutas de datos ────────────────────────────────────────────────
# Deben existir y ser escribibles por el usuario del servicio (www-data).
DATA_ROOT=/var/www/cogny/data
VAULT_ROOT=/var/www/cogny/data/vault
# Directorio del avatar (fichero único `avatar.jpg`). Servido por nginx en
# /static/avatars/ vía un location específico (NO está en collectstatic para
# que `manage.py collectstatic --clear` no lo borre).
AVATARS_ROOT=/var/www/cogny/avatars

# Donde collectstatic vuelca los estáticos. nginx sirve /static/ directamente
# desde aquí (alias), no desde `static/`. Por defecto BASE_DIR/static_collected
# si no se especifica.
# STATIC_ROOT=/var/www/cogny/django_app/static_collected

# Ruta del fichero SQLite.
DB_PATH=/var/www/cogny/data/db.sqlite3

# Subdominio DNS-only para importar bóvedas > 100 MB (esquiva el proxy de
# Cloudflare, que limita el tamaño de request). Déjalo vacío si no lo usas.
UPLOAD_HOST=
