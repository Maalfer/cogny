# Django
# Genera con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=CHANGE-ME-50-RANDOM-CHARS

# 1 = modo desarrollo (no usar en producción)
DJANGO_DEBUG=0

# CSV de hosts permitidos (Host header), sin espacios
DJANGO_ALLOWED_HOSTS=cogny.example.com,127.0.0.1,localhost

# Sube este valor (v1, v2, v3...) cada vez que cambies un estático global
# para forzar cache-busting (?v=... en base.html)
ASSET_VERSION=v1

# Rutas de datos: deben existir y ser escribibles por el usuario del servicio
DATA_ROOT=/path/to/data
VAULT_ROOT=/path/to/data/vault
AVATARS_ROOT=/path/to/avatars

# Subdominio DNS-only opcional para importar bóvedas grandes esquivando un
# proxy tipo Cloudflare (deja vacío si no aplica)
UPLOAD_HOST=

# Base de datos: SQLite (solo cuentas de usuario; las notas viven en VAULT_ROOT)
DB_PATH=/path/to/data/db.sqlite3
